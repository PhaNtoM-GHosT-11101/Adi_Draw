{
  "name": "adi-draw",
  "version": "1.0.0",
  "private": true,
  "description": "Adi Draw \u2014 a whiteboard where every pen, colour and shortcut is yours to configure. Pressure-sensitive ink, shapes, text, sticky notes, layers, and an incremental renderer that only repaints what changed.",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173",
    "desktop": "concurrently -k \"vite\" \"wait-on tcp:5273 && electron .\"",
    "desktop:build": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder",
    "test": "npm run typecheck && node test/smoke.mjs && node test/ui-check.mjs && node test/incremental.mjs && node test/preview.mjs && node test/pens.mjs && node test/recognise.mjs && node test/sections.mjs && node test/inkshape.mjs && node test/sections-ui.mjs && node test/theme.mjs",
    "test:visual": "node test/visual.mjs",
    "test:svg": "node test/svg-check.mjs",
    "typecheck": "tsc --noEmit",
    "test:ui": "node test/ui-check.mjs",
    "test:incremental": "node test/incremental.mjs",
    "test:theme": "node test/theme.mjs",
    "perf": "node test/perf.mjs",
    "deploy": "node scripts/deploy.mjs",
    "test:deployed": "node test/deployed.mjs",
    "icons": "node scripts/icons.mjs",
    "test:preview": "node test/preview.mjs",
    "test:pens": "node test/pens.mjs"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "electron": "^33.3.1",
    "electron-builder": "^25.1.8",
    "playwright": "^1.54.0",
    "typescript": "^5.7.3",
    "vite": "^6.0.11",
    "wait-on": "^8.0.2"
  },
  "build": {
    "appId": "dev.inkboard.app",
    "productName": "Adi Draw",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "build/icon.png"
    ],
    "directories": {
      "output": "release"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "build/icon.png",
      "category": "Graphics",
      "desktop": {
        "Name": "Adi Draw"
      }
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "build/icon.png"
    },
    "icon": "build/icon.png"
  },
  "homepage": "https://phanthom-ghost-11101.github.io/Adi_Draw/",
  "repository": {
    "type": "git",
    "url": "https://github.com/PhaNtoM-GHosT-11101/Adi_Draw.git"
  },
  "keywords": [
    "whiteboard",
    "drawing",
    "pressure-sensitive",
    "stylus",
    "canvas",
    "excalidraw",
    "one-note",
    "electron",
    "offline-first",
    "pwa"
  ],
  "license": "MIT",
  "author": "Aditya Priyadarshi"
}
